# Public URL of the site (no trailing slash). Used for SEO, emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Brevo → SMTP & API → API keys
BREVO_API_KEY=
# A sender address you verified in Brevo (Senders, domains & dedicated IPs)
EMAIL_FROM=
EMAIL_FROM_NAME=Brittany Niemi Rescues
# Where new-application notifications are sent
RESCUE_NOTIFY_EMAIL=

# Only needed to run scripts/seed-demo.ts (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=
