// Cloudflare Workers config. Setup steps are in SETUP.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brittany-niemi-rescues",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The site lives only at bnrescues.com (www redirects there, see src/proxy.ts)
  "routes": [
    { "pattern": "bnrescues.com", "custom_domain": true },
    { "pattern": "www.bnrescues.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "brittany-niemi-rescues" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brittany-niemi-rescues",
      // From `npx wrangler d1 create brittany-niemi-rescues`
      "database_id": "dc1cef98-2d22-4946-a91e-4289c307adb9",
      "migrations_dir": "migrations"
    },
    {
      // Same database, used by OpenNext to track which cached pages are out of date
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "brittany-niemi-rescues",
      "database_id": "dc1cef98-2d22-4946-a91e-4289c307adb9"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "brittany-niemi-rescues-photos" }],
  // Cache for public pages (they refresh hourly, and right away when something is edited).
  // Hourly keeps cache writes well under the free plan's 1,000 KV writes a day.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      // From `npx wrangler kv namespace create cache`
      "id": "d4a5f0bd7513475bb2a63acea3d9e155"
    }
  ],
  // Email settings (not secret). The Brevo API key is a secret: `npx wrangler secret put BREVO_API_KEY`
  "vars": {
    "EMAIL_FROM": "hello@bnrescues.com",
    "EMAIL_FROM_NAME": "Brittany Niemi Rescues",
    "RESCUE_NOTIFY_EMAIL": "brittany.niemi.rescues@outlook.com"
  },
  "observability": { "enabled": true },
  "env": {
    // Used only while building for deploy (scripts/deploy.mjs). It points at an empty local
    // database, so the build never bakes in sample or out-of-date data; after deploying, the
    // script marks the built pages stale so the first visit renders them from the live database.
    "build": {
      // Never deployed; it must not inherit the custom domains. It needs no email settings either.
      "routes": [],
      "vars": {},
      "services": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "build-only",
          "database_id": "00000000-0000-0000-0000-00000000b11d",
          "migrations_dir": "migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "build-only",
          "database_id": "00000000-0000-0000-0000-00000000b11d"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "brittany-niemi-rescues-photos" }],
      "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "d4a5f0bd7513475bb2a63acea3d9e155" }]
    }
  }
}
