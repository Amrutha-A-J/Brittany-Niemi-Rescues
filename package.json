{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_DEMO=1 NEXT_DIST_DIR=.next-demo next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:demo": "NEXT_PUBLIC_DEMO=1 next build",
    "build:pages": "node scripts/build-pages.mjs",
    "db:new": "wrangler d1 migrations create DB",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/d1.mjs seed",
    "staff:add": "node scripts/d1.mjs staff",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --env-file .env.example"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
