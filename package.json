{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "NEXT_PUBLIC_DEMO=1 NEXT_DIST_DIR=.next-demo next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:new": "node scripts/db.mjs new",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "supabase db reset && node --env-file=.env.local scripts/seed-demo.mts",
    "db:status": "node scripts/db.mjs status",
    "db:push": "node scripts/db.mjs push",
    "db:seed": "node --env-file=.env.local scripts/seed-demo.mts",
    "db:seed:demo": "node --env-file=.env.demo scripts/seed-demo.mts",
    "build:demo": "NEXT_PUBLIC_DEMO=1 next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
